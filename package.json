{
  "name": "atlas-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "lint": "pnpm --filter @atlas/web lint",
    "typecheck": "pnpm --filter @atlas/web typecheck",
    "test": "pnpm --filter @atlas/web test",
    "quality:snapshot": "node scripts/quality-snapshot.mjs"
  }
}
