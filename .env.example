# The browser calls the API directly in local development.
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000
ATLAS_POSTGRES_HOST_PORT=55432
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_only@localhost:55432/atlas
# Standard psycopg URL used only by the disposable concurrency learning lab.
ATLAS_POSTGRES_LAB_URL=postgresql://atlas:atlas_dev_only@localhost:55432/atlas
# Optional Phase 4 MariaDB provider and isolated learning-lab account.
ATLAS_MARIADB_HOST_PORT=53307
ATLAS_MARIADB_OBSERVER_URL=mariadb+pymysql://atlas_observer:atlas_observer_dev_only@localhost:53307/atlas_lab
ATLAS_MARIADB_LAB_HOST=127.0.0.1
ATLAS_MARIADB_LAB_PORT=53307
ATLAS_MARIADB_LAB_USER=atlas_lab
ATLAS_MARIADB_LAB_PASSWORD=atlas_lab_dev_only
ATLAS_MARIADB_LAB_DATABASE=atlas_lab
# Optional MongoDB derived read model and isolated document lab.
ATLAS_MONGODB_HOST_PORT=57017
ATLAS_MONGODB_PROJECTION_URL=mongodb://atlas_projection:atlas_projection_dev_only@localhost:57017/atlas_document?authSource=atlas_document
ATLAS_MONGODB_LAB_URL=mongodb://atlas_document_lab:atlas_document_lab_dev_only@localhost:57017/atlas_document_lab?authSource=atlas_document_lab
# Optional Redis cache-aside product adapter and isolated stream/transaction lab.
ATLAS_REDIS_HOST_PORT=56379
ATLAS_REDIS_CACHE_URL=redis://atlas_cache:atlas_cache_dev_only@localhost:56379/0
ATLAS_REDIS_LAB_URL=redis://atlas_lab:atlas_lab_dev_only@localhost:56379/0
ATLAS_ALLOWED_ORIGINS=http://localhost:3000
# Local development token. Production deployments must use an OIDC adapter.
ATLAS_DEV_TOKEN=atlas-local-development-token
ATLAS_ENVIRONMENT=development
# Public browser endpoint; tickets are opaque, short-lived, and single use.
ATLAS_BROWSER_WS_URL=ws://localhost:8000/v1/realtime/ws
# Optional CPU-only neural training image; rebuild API after changing.
ATLAS_NEURAL=false
# Optional Phase 8 repository intelligence. Luna handles low-cost explanations;
# Terra handles balanced review/change planning. Never commit the real key.
ATLAS_OPENAI_API_KEY=
ATLAS_AI_ECONOMY_MODEL=gpt-5.6-luna
ATLAS_AI_BALANCED_MODEL=gpt-5.6-terra
ATLAS_AI_MONTHLY_BUDGET_USD=25
ATLAS_AI_RUN_RESERVATION_USD=0.25
ATLAS_AI_RESERVATION_TTL_SECONDS=900
ATLAS_AI_SLO_AVAILABILITY_TARGET=0.99
ATLAS_AI_SLO_P95_SECONDS_TARGET=30
# Phase 9 write access is local-operator-only and opt-in. Never enable this on a
# public/shared deployment; remote use requires isolated workspaces and OIDC.
ATLAS_AI_PATCH_TOOLS_ENABLED=false
ATLAS_AI_PATCH_MAX_FILE_BYTES=256000
ATLAS_AI_PATCH_MAX_CHANGED_LINES=200
# Test execution requires this independent opt-in plus the patch flag. The worker
# has no host fallback and requires the locally built, fixed Docker image.
ATLAS_AI_TEST_TOOLS_ENABLED=false
# Optional operator-controlled local OpenAI-compatible runtime. The URL is never
# accepted from browser requests. Ollama commonly exposes this shape on port 11434.
ATLAS_LOCAL_AI_ENABLED=false
ATLAS_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
ATLAS_LOCAL_AI_MODEL=atlas-local-code-model
ATLAS_LOCAL_AI_API_KEY=
# Optional trusted local streaming. Never enable in a shared/public environment.
ATLAS_STREAMING_ENABLED=false
ATLAS_STREAMING_PROVIDER=sqlite
ATLAS_STREAMING_STORE=./atlas-streaming.db
ATLAS_KAFKA_BOOTSTRAP=127.0.0.1:59092
ATLAS_KAFKA_HOST_PORT=59092
ATLAS_STREAMING=false
ATLAS_LAKEHOUSE_ENABLED=false
ATLAS_USAGE_COMPUTE_ENABLED=false
ATLAS_USAGE_COMPUTE_STORE=./artifacts/usage-compute
ATLAS_FLINK_ENABLED=false
ATLAS_FLINK_API_URL=http://127.0.0.1:58081
ATLAS_FLINK_JOB_ID=
ATLAS_FLINK_TENANT=northstar
ATLAS_SUPERSET_ENABLED=false
ATLAS_SUPERSET_API_URL=http://127.0.0.1:58088
ATLAS_SUPERSET_API_TOKEN=
ATLAS_SUPERSET_DASHBOARD_ID=
ATLAS_SUPERSET_TENANT=northstar
ATLAS_SUPERSET_SECRET_KEY=
ATLAS_USAGE_BI_STORE=./artifacts/usage-bi
ATLAS_LAKEHOUSE_STORE=./artifacts/usage-lakehouse

ATLAS_LAKEHOUSE=false
# Airflow status uses a server-held JWT; never put it in NEXT_PUBLIC variables.
ATLAS_AIRFLOW_ENABLED=false
ATLAS_AIRFLOW_API_URL=http://127.0.0.1:58080
ATLAS_AIRFLOW_API_TOKEN=
ATLAS_AIRFLOW_TENANT=northstar
ATLAS_PIPELINE_ENABLED=false
ATLAS_PIPELINE_API_URL=http://127.0.0.1:8000
ATLAS_PIPELINE_API_TOKEN=
ATLAS_PIPELINE_TENANT=northstar
# Offline, owner-only review of the source-owned Kubernetes deployment.
ATLAS_DEPLOYMENT_REVIEW_ENABLED=false
ATLAS_INFRASTRUCTURE_PLAN_ENABLED=false
