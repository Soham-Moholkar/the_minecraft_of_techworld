{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/lab-manifest.schema.json",
  "title": "ATLAS lab manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain", "runtime", "difficulty", "commands", "resources", "safety", "telemetry"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "domain": { "type": "string" },
    "runtime": { "enum": ["process", "docker", "compose", "kubernetes"] },
    "difficulty": { "enum": ["foundation", "intermediate", "advanced", "expert"] },
    "commands": {
      "type": "object",
      "required": ["start", "test", "reset"],
      "properties": { "start": {"type":"string"}, "test": {"type":"string"}, "reset": {"type":"string"} }
    },
    "resources": { "type": "object", "required": ["cpu", "memory"] },
    "safety": { "type": "object", "required": ["internet_access_required", "vulnerable_target"] },
    "telemetry": { "type": "object", "required": ["logs", "metrics", "traces"] }
  }
}

